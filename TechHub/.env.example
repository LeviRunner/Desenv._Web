# ========================================
# Configurações do TechHub
# ========================================
# Copie este arquivo para .env e configure os valores
# cp .env.example .env

# ========================================
# INFORMAÇÕES DO SITE
# ========================================
SITE_NAME=TechHub
SITE_DESCRIPTION=Centro de aprendizado de desenvolvimento web
SITE_URL_DEV=http://localhost:3000
SITE_URL_PROD=https://techhub.com.br

# ========================================
# AMBIENTE
# ========================================
# Valores: development, staging, production
NODE_ENV=development

# ========================================
# SERVIDOR
# ========================================
# HOST: 0.0.0.0 (todos os IPs), localhost (apenas local), IP específico
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ========================================
# SEGURANÇA
# ========================================
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=sua_chave_secreta_super_segura_2026
JWT_EXPIRES_IN=24h
BCRYPT_SALT=10

# ========================================
# BANCO DE DADOS
# ========================================
DB_TYPE=json
USERS_FILE=./usuarios.json
BACKUP_DIR=./backups

# ========================================
# CORS - Origens Permitidas
# ========================================
# Use vírgula para separar múltiplas origens
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.10.43:3000

# ========================================
# DIRETÓRIOS
# ========================================
STATIC_DIR=./src/T3
UPLOAD_DIR=./uploads
LOG_DIR=./logs

# ========================================
# LOGS
# ========================================
# Valores: debug, info, warn, error
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# ========================================
# RECURSOS
# ========================================
ENABLE_REGISTRATION=true
ENABLE_CHART_JS=true
ENABLE_DEMO_MODE=true

# ========================================
# MIGRAÇÃO PARA PRODUÇÃO
# ========================================
# Quando migrar para outro servidor:
# 1. Copie este arquivo para .env
# 2. Altere SERVER_HOST para seu domínio ou IP
# 3. Altere NODE_ENV para production
# 4. Gere uma nova SECRET_KEY segura
# 5. Atualize SITE_URL_PROD para seu domínio
# 6. Configure ALLOWED_ORIGINS com suas URLs permitidas
